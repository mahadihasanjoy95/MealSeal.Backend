@baseUrl = http://localhost:5203
@adminEmail = admin@mealseal.local
@adminPassword = ChangeMe123!
@adminToken = replace-with-token-from-login-response

GET {{baseUrl}}/health
Accept: application/json

###
GET {{baseUrl}}/public-key
Accept: application/json

###
POST {{baseUrl}}/auth/login
Content-Type: application/json

{
  "email": "{{adminEmail}}",
  "password": "{{adminPassword}}"
}

###
POST {{baseUrl}}/vouchers/create
Authorization: Bearer {{adminToken}}
Content-Type: application/json

{
  "recipientRef": "recipient-001",
  "restaurantId": "restaurant-001",
  "mealType": "Lunch",
  "quantity": 1,
  "expiryDate": "2026-12-31"
}

###
GET {{baseUrl}}/vouchers
Authorization: Bearer {{adminToken}}
Accept: application/json
