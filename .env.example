# PostgreSQL (Neon in production, local PostgreSQL during development)
ConnectionStrings__Postgres=Host=localhost;Port=5432;Database=mealseal;Username=postgres;Password=change-me

# Firebase Admin service account. Prefer the JSON variable on Render.
Firebase__ProjectId=mealseal-c49a9
Firebase__ServiceAccountPath=firebase-service-account.json
# Firebase__ServiceAccountJson={...complete service account JSON...}

# Existing Firebase user UIDs copied from Firestore users/{uid} documents.
Seed__AdminUid=replace-with-admin-firebase-uid
Seed__StaffUid=replace-with-staff-firebase-uid
Seed__StaffRestaurantId=replace-with-restaurant-id

# Production secrets can be multiline PEM strings (or use mounted key files locally).
# MealSeal__PrivateKeyPem=-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----
# MealSeal__PublicKeyPem=-----BEGIN PUBLIC KEY-----\n...\n-----END PUBLIC KEY-----
