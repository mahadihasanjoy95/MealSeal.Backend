# Local PostgreSQL development (Npgsql keyword format)
ConnectionStrings__Postgres=Host=localhost;Port=5432;Database=mealseal;Username=postgres;Password=change-me

# Neon/production. DATABASE_URL is pooled application traffic; UNPOOLED is direct for EF migrations.
# DATABASE_URL=postgresql://user:password@ep-example-pooler.region.aws.neon.tech/neondb?sslmode=require
# DATABASE_URL_UNPOOLED=postgresql://user:password@ep-example.region.aws.neon.tech/neondb?sslmode=require
# Equivalent optional Npgsql names:
# ConnectionStrings__Postgres=Host=...-pooler...;Database=neondb;Username=...;Password=...;SSL Mode=Require
# ConnectionStrings__PostgresMigration=Host=...;Database=neondb;Username=...;Password=...;SSL Mode=Require

# MealSeal's own access tokens (replaces Firebase Authentication). The signing key pair lives at
# keys/auth-private-key.pem / keys/auth-public-key.pem (generate with `dotnet run -- --generate-keys`),
# or provide them inline here for deployment, same as the voucher-signing MealSeal__* keys below.
Auth__Issuer=mealseal-api
Auth__Audience=mealseal-app
Auth__AccessTokenLifetimeMinutes=720
# Auth__PrivateKeyPem=-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----
# Auth__PublicKeyPem=-----BEGIN PUBLIC KEY-----\n...\n-----END PUBLIC KEY-----

# Bootstrap "super admin" account, hashed into the database on first startup. Change the password
# via POST /auth/users/{userId}/reset-password once signed in.
Seed__AdminEmail=admin@mealseal.example
Seed__AdminPassword=replace-with-a-strong-password

# One café-staff account per café (hillside@/riverside@/corner@mealseal.local — see
# DatabaseSeeder.StaffAccounts, kept in lockstep with the mobile app's café picker), all sharing
# this one password. Leave unset to skip seeding any café-staff accounts at all.
Seed__StaffPassword=replace-with-a-strong-password

# Production secrets can be multiline PEM strings (or use mounted key files locally).
# MealSeal__PrivateKeyPem=-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----
# MealSeal__PublicKeyPem=-----BEGIN PUBLIC KEY-----\n...\n-----END PUBLIC KEY-----
